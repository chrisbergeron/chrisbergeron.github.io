# projects.chrisbergeron.com — serve the /projects page at the subdomain root.
# Host-scoped + forced (200!) so only this subdomain root is rewritten;
# assets and all other paths still resolve normally from the same deploy.
https://projects.chrisbergeron.com/  /projects/index.html  200!
http://projects.chrisbergeron.com/   /projects/index.html  200!

# about. / about-me. — 301 to the canonical about page on the apex so search
# and answer engines see a single URL (HC-1172). Forced (301!) because "/"
# otherwise matches the real index.html and the redirect would never fire.
https://about.chrisbergeron.com/     https://chrisbergeron.com/about/  301!
http://about.chrisbergeron.com/      https://chrisbergeron.com/about/  301!
https://about-me.chrisbergeron.com/  https://chrisbergeron.com/about/  301!
http://about-me.chrisbergeron.com/   https://chrisbergeron.com/about/  301!

# /.well-known/* rewrites — Netlify's build isn't shipping the dot-dir for
# this site; serve identical content from root-level paths via 200 rewrites.
# Preserves the /.well-known/* URL surface for ARD/keybase/age consumers.
/.well-known/ai-catalog.json  /ai-catalog.json  200
/.well-known/age.pub          /age.pub          200
/.well-known/keybase.txt      /keybase.txt      200

# Email-capture endpoint (HC-1135) — must precede the catchall below.
/api/subscribe  /.netlify/functions/subscribe  200

# Historical catchall — anything else that does not match a real file goes home.
/*    https://chrisbergeron.com/:splat   301
